                ;;
            02|2)
                msg -ne "Usuario a eliminar: "; read -r username
                delete_user "${username}"
                ;;
            03|3) list_users ;;
            04|4)
                msg -ne "Usuario: "; read -r username
                show_user_credentials "${username}"
                ;;
            05|5) show_active_connections ;;
            06|6) configure_dropbear_ports ;;
            07|7) configure_websocket_port ;;
            08|8) sync_ws_auth; success "Auth WebSocket sincronizado" ;;
            09|9) install_shadowsocks ;;
            10) install_v2ray ;;
            11) install_trojan ;;
            12) install_wireguard ;;
            13) install_openvpn ;;
            14) install_badvpn ;;
            15)
                msg -ne "Usuario: "; read -r username
                msg -ne "Límite KB/s (0=ilimitado): "; read -r limit
