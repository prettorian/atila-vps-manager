# ───────────────────────────────────────────────────────────────────────────
# Dropbear (SSH Ligero - Múltiples Puertos)
# ───────────────────────────────────────────────────────────────────────────
install_dropbear() {
    info "Instalando Dropbear (SSH ligero)..."
    
    install_package dropbear
    
    # Leer puertos configurados o usar defaults
    local ports_file="${CONFIG_DIR}/dropbear_ports.conf"
    local DROPBEAR_PORTS="${DROPBEAR_DEFAULT_PORTS}"
    
    if [[ -f "${ports_file}" ]]; then
        DROPBEAR_PORTS=$(cat "${ports_file}")
    fi
    
    # Construir argumentos para dropbear
    local EXTRA_ARGS=""
    for port in ${DROPBEAR_PORTS}; do
        EXTRA_ARGS+=" -p ${port}"
    done
    
    # Configurar /etc/default/dropbear
    cat > /etc/default/dropbear << EOF
NO_START=0
DROPBEAR_PORT=${SSH_PORT}
DROPBEAR_EXTRA_ARGS="${EXTRA_ARGS}"
DROPBEAR_BANNER=""
DROPBEAR_RSAKEY="/etc/dropbear/dropbear_rsa_host_key"
DROPBEAR_DSSKEY="/etc/dropbear/dropbear_dss_host_key"
EOF
    
    # Permitir puertos en firewall
    for port in ${DROPBEAR_PORTS}; do
        iptables -I INPUT -p tcp --dport "${port}" -j ACCEPT 2>/dev/null || true
    done
    iptables-save > /etc/iptables/rules.v4 2>/dev/null || true
    
    # Reiniciar servicio
    systemctl restart dropbear 2>/dev/null || service dropbear restart 2>/dev/null || true
    
    success "Dropbear instalado en puertos: ${DROPBEAR_PORTS}"
}

configure_dropbear_ports() {
    msg -title "🔌 Configurar Puertos Dropbear"
    
    echo -e "${C_CYAN}Puertos actuales:${C_RESET} $(grep DROPBEAR_EXTRA_ARGS /etc/default/dropbear 2>/dev/null | grep -oP '\-p \K[0-9]+' | tr '\n' ' ' || echo 'ninguno')"
    echo -e "${C_YELLOW}Instrucciones:${C_RESET}"
    echo "• Ingresa los puertos separados por espacio (ej: 443 777 2222)"
    echo "• Evita puertos menores a 1024 si no eres root"
    echo ""
    
    msg -ne "Nuevos puertos: "
    read -r ports_input
    
    if [[ -z "${ports_input}" ]]; then
        warn "No se ingresaron puertos. Cancelando."
        return 1
    fi
    
    # Validar que sean números válidos
    local valid=true
    for port in ${ports_input}; do
        if ! [[ "${port}" =~ ^[0-9]+$ ]] || [[ "${port}" -lt 1 ]] || [[ "${port}" -gt 65535 ]]; then
            error "Puerto inválido: ${port}"
            valid=false
        fi
    done
    [[ "${valid}" == false ]] && return 1
    
    # Guardar configuración
    echo "${ports_input}" > "${CONFIG_DIR}/dropbear_ports.conf"
    
    # Re-aplicar configuración
    install_dropbear
    
    success "Dropbear configurado en puertos: ${ports_input}"
}

# ───────────────────────────────────────────────────────────────────────────
# WebSocket SOCKS con TLS (GOST)
# ───────────────────────────────────────────────────────────────────────────
generate_ssl_certs() {
    info "Generando certificados SSL para WebSocket..."
    mkdir -p "${CERTS_DIR}"
    
    if [[ ! -f "${CERTS_DIR}/cert.pem" ]]; then
        openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
            -keyout "${CERTS_DIR}/key.pem" \
            -out "${CERTS_DIR}/cert.pem" \
            -subj "/CN=atila-vps.local/O=ATILA-VPS/C=US" \
            2>/dev/null
        chmod 600 "${CERTS_DIR}/key.pem"
        success "Certificado autofirmado generado"
    else
        info "Certificado existente. Omitiendo."
    fi
}

sync_ws_auth() {
    # Generar archivo de auth para gost (usuario:contraseña por línea)
    > "${WS_AUTH_FILE}"
    while IFS=: read -r u p rest; do
        echo "${u}:${p}" >> "${WS_AUTH_FILE}"
    done < "${USERS_FILE}"
    chmod 600 "${WS_AUTH_FILE}"
}

install_websocket() {
    info "Instalando GOST para Proxy SOCKS sobre WebSocket..."
    
    # Descargar GOST
    local gost_url="https://github.com/ginuerzh/gost/releases/latest/download/gost-linux-amd64-2.12.0.gz"
    local arch=$(dpkg --print-architecture 2>/dev/null || echo "amd64")
    [[ "${arch}" == "arm64" ]] && gost_url="https://github.com/ginuerzh/gost/releases/latest/download/gost-linux-arm64-2.12.0.gz"
    
    curl -sL "${gost_url}" -o "${TMP_DIR}/gost.gz" 2>/dev/null || {
        warn "No se pudo descargar GOST. Verifica tu conexión."
        return 1
    }
    
    gunzip -f "${TMP_DIR}/gost.gz"
    mv "${TMP_DIR}/gost" /usr/local/bin/
    chmod +x /usr/local/bin/gost
    
    # Generar certificados
    generate_ssl_certs
    
    # Sincronizar auth
    sync_ws_auth
    
    # Leer puerto configurado o usar default
    local ws_port="${WS_DEFAULT_PORT}"
    if [[ -f "${CONFIG_DIR}/ws_port.conf" ]]; then
        ws_port=$(cat "${CONFIG_DIR}/ws_port.conf")
    fi
    
    # Crear servicio systemd
    cat > /etc/systemd/system/atila-ws.service << EOF
[Unit]
Description=ATILA-VPS WebSocket SOCKS Proxy
After=network.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/gost -L "wss://:${ws_port}?cert=${CERTS_DIR}/cert.pem&key=${CERTS_DIR}/key.pem&auth=${WS_AUTH_FILE}"
Restart=on-failure
RestartSec=3s
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
EOF
    
    # Permitir puerto en firewall
    iptables -I INPUT -p tcp --dport "${ws_port}" -j ACCEPT 2>/dev/null || true
    iptables-save > /etc/iptables/rules.v4 2>/dev/null || true
    
    # Activar servicio
    systemctl daemon-reload
    systemctl enable --now atila-ws 2>/dev/null || true
    
    success "GOST WebSocket SOCKS activo en wss://TU_IP:${ws_port}"
}

configure_websocket_port() {
    msg -title "🌐 Configurar Puerto WebSocket"
    
    echo -e "${C_CYAN}Puerto actual:${C_RESET} $(grep -oP 'wss://:\K[0-9]+' /etc/systemd/system/atila-ws.service 2>/dev/null || echo "${WS_DEFAULT_PORT}")"
    echo -e "${C_YELLOW}Recomendaciones:${C_RESET}"
    echo "• Usa puerto 443 para compatibilidad con Cloudflare/CDN"
    echo "• Requiere certificado SSL válido para WSS (TLS)"
    echo ""
    
    msg -ne "Nuevo puerto (1024-65535): "
    read -r new_port
    
    if ! [[ "${new_port}" =~ ^[0-9]+$ ]] || [[ "${new_port}" -lt 1024 ]] || [[ "${new_port}" -gt 65535 ]]; then
        error "Puerto inválido. Debe estar entre 1024 y 65535"
        return 1
    fi
    
    # Verificar que el puerto no esté en uso
    if ss -tlnp | grep -q ":${new_port} "; then
        error "El puerto ${new_port} ya está en uso"
        return 1
    fi
    
    # Guardar configuración
    echo "${new_port}" > "${CONFIG_DIR}/ws_port.conf"
    
    # Actualizar servicio systemd
    local ws_service="/etc/systemd/system/atila-ws.service"
    if [[ -f "${ws_service}" ]]; then
        sed -i "s/wss://:[0-9]\+/wss:\/\/:${new_port}/" "${ws_service}"
        success "Configuración actualizada a puerto ${new_port}"
    else
        warn "Servicio atila-ws no encontrado. ¿Instalaste WebSocket primero?"
        return 1
    fi
    
    # Permitir puerto en firewall
    iptables -I INPUT -p tcp --dport "${new_port}" -j ACCEPT 2>/dev/null || true
    iptables-save > /etc/iptables/rules.v4 2>/dev/null || true
    
    # Aplicar cambios
    systemctl daemon-reload
    
    echo -e "\n${C_YELLOW}⚠️ Para aplicar los cambios, reinicia el servicio:${C_RESET}"
    echo -e "${C_WHITE}sudo systemctl restart atila-ws${C_RESET}"
}

