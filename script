# ───────────────────────────────────────────────────────────────────────────
# WireGuard VPN
# ───────────────────────────────────────────────────────────────────────────
install_wireguard() {
    info "Instalando WireGuard..."
    
    install_package wireguard
    
    # Generar claves
    wg genkey | tee /etc/wireguard/private.key | wg pubkey > /etc/wireguard/public.key
    chmod 600 /etc/wireguard/*.key
    
    # Obtener interfaz de salida
    local outbound_iface
    outbound_iface=$(ip route | grep default | awk '{print $5}' | head -1)
    
    # Configuración básica del servidor
    cat > /etc/wireguard/wg0.conf << EOF
[Interface]
Address = 10.0.0.1/24
ListenPort = ${WIREGUARD_PORT}
PrivateKey = $(cat /etc/wireguard/private.key)
PostUp = iptables -A FORWARD -i wg0 -j ACCEPT; iptables -t nat -A POSTROUTING -o ${outbound_iface} -j MASQUERADE
PostDown = iptables -D FORWARD -i wg0 -j ACCEPT; iptables -t nat -D POSTROUTING -o ${outbound_iface} -j MASQUERADE
SaveConfig = true

# Ejemplo de cliente (generar uno por usuario)
# [Peer]
# PublicKey = CLIENT_PUBLIC_KEY
# AllowedIPs = 10.0.0.2/32
EOF
    chmod 600 /etc/wireguard/wg0.conf
    
    # Permitir puerto en firewall
    iptables -I INPUT -p udp --dport ${WIREGUARD_PORT} -j ACCEPT 2>/dev/null || true
    
    # Activar servicio
    systemctl enable --now wg-quick@wg0 2>/dev/null || true
    
    success "WireGuard instalado en puerto ${WIREGUARD_PORT}"
}

