#!/bin/bash

# =============================================================================
# ATILA-VPS MANAGER v2.0-PRO
# Compatible: Ubuntu 18.04-24.04 | Debian 9-12
# Requiere: root/sudo
# Autor: Custom Script | Licencia: MIT
# =============================================================================

set -o pipefail

# Colores
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
CYAN='\033[1;36m'
WHITE='\033[1;37m'
NC='\033[0m'

# Variables globales
SSH_PORT=22
DROPBEAR_PORT=143
SOCKS_PORT=1080
WS_PORT=8080
CUSTOM_PORT=40000
SSL_ENABLED=false
WATCHDOG_ENABLED=false

OS_NAME=""
OS_VERSION=""
PKG_MGR="apt"
SVC_CMD="systemctl"
BACKUP_DIR="/etc/atila-backup"

# =============================================================================
# FUNCIONES BASE
# =============================================================================
check_root() {
    if [ "$EUID" -ne 0 ]; then
        echo -e "${RED}✗ Este script requiere permisos de root. Ejecuta: sudo $0${NC}"
        exit 1
    fi
}

detect_os() {
    if [ ! -f /etc/os-release ]; then
        echo -e "${RED}✗ No se pudo detectar el sistema operativo.${NC}"
        exit 1
    fi
    . /etc/os-release
    OS_NAME=$NAME
    OS_VERSION=${VERSION_ID%%.*}

    if [[ "$OS_NAME" == "Ubuntu" ]] && (( OS_VERSION >= 18 && OS_VERSION <= 24 )); then
        echo -e "${GREEN}✓ $OS_NAME $VERSION_ID detectado y soportado.${NC}"
    elif [[ "$OS_NAME" == "Debian" ]] && (( OS_VERSION >= 9 )); then
        echo -e "${GREEN}✓ $OS_NAME $VERSION_ID detectado y soportado.${NC}"
    else
        echo -e "${RED}✗ Versión no soportada. Requiere Ubuntu 18-24 o Debian 9+${NC}"
        exit 1
    fi
    sleep 1
}

backup_configs() {
    local ts=$(date +%F_%H%M%S)
    local dir="$BACKUP_DIR/$ts"
    mkdir -p "$dir"
    local files=(/etc/ssh/sshd_config /etc/default/dropbear /etc/stunnel/stunnel.conf)
    for f in "${files[@]}"; do
        [ -f "$f" ] && cp -p "$f" "$dir/" 2>/dev/null
    done
    echo -e "${CYAN}✓ Backup automático creado en: $dir${NC}"
}

install_deps() {
    echo -e "${YELLOW}🔄 Actualizando repositorios e instalando dependencias...${NC}"
    DEBIAN_FRONTEND=noninteractive $PKG_MGR update -y >/dev/null 2>&1
    DEBIAN_FRONTEND=noninteractive $PKG_MGR install -y \
        openssh-server dropbear stunnel4 curl wget openssl net-tools \
        dante-server ss5 >/dev/null 2>&1
    echo -e "${GREEN}✓ Dependencias listas.${NC}"
}

confirm_action() {
    echo -ne "${YELLOW}  ¿Aplicar cambios? (s/n): ${NC}"
    read -r ans
    [[ "$ans" =~ ^[sS]$ ]] || return 1
    return 0
}

# =============================================================================
# INTERFAZ
# =============================================================================
show_banner() {
    clear
    echo -e "${CYAN}"
    echo "╔═══════════════════════════════════════════════════════════╗"
    echo "║               ATILA-VPS MANAGER                           ║"
    echo "║                    Versión 2.0 [PRO]                      ║"
    echo "╚═══════════════════════════════════════════════════════════╝"
    echo -e "${NC}\n"
}

show_menu() {
    show_banner
    echo -e "${GREEN}┌─────────────────────────────────────────────────────────────┐${NC}"
    echo -e "${GREEN}│${NC}                    ${YELLOW}MENÚ PRINCIPAL${NC}                      ${GREEN}│${NC}"
    echo -e "${GREEN}└─────────────────────────────────────────────────────────────┘${NC}"
    echo ""
    echo -e "${WHITE}  ${GREEN}1)${NC} Crear usuario SSH"
    echo -e "${WHITE}  ${GREEN}2)${NC} Configurar puerto SSH"
    echo -e "${WHITE}  ${GREEN}3)${NC} Configurar Dropbear (SSH Ligero)"
    echo -e "${WHITE}  ${GREEN}4)${NC} Configurar Proxy SOCKS5"
    echo -e "${WHITE}  ${GREEN}5)${NC} Configurar Tunnel WebSocket"
    echo -e "${WHITE}  ${GREEN}6)${NC} Configurar puerto personalizado"
    echo -e "${WHITE}  ${GREEN}7)${NC} Configurar SSL/TLS"
    echo -e "${WHITE}  ${GREEN}8)${NC} Activar/Desactivar Watchdog"
    echo -e "${WHITE}  ${GREEN}9)${NC} Bloquear/Desbloquear usuario"
    echo -e "${WHITE}  ${GREEN}10)${NC} Ver información del sistema"
    echo -e "${WHITE}  ${GREEN}11)${NC} Reiniciar servicios"
    echo -e "${WHITE}  ${GREEN}12)${NC} Cambiar tema visual"
    echo -e "${WHITE}  ${GREEN}0)${NC} Salir"
    echo ""
    echo -ne "${CYAN}  Seleccione una opción: ${NC}"
}

# =============================================================================
# FUNCIONES PRINCIPALES
# =============================================================================
create_user() {
    show_banner
    echo -e "${GREEN}┌─────────────────────────────────────────────────────────────┐${NC}"
    echo -e "${GREEN}│${NC}                ${YELLOW}CREAR USUARIO SSH${NC}                       ${GREEN}│${NC}"
    echo -e "${GREEN}└─────────────────────────────────────────────────────────────┘${NC}"
    echo ""
    read -p "  Nombre de usuario: " username
    read -sp "  Contraseña: " pass; echo
    read -sp "  Confirmar contraseña: " pass2; echo

    if [ "$pass" != "$pass2" ]; then
        echo -e "${RED}  ✗ Las contraseñas no coinciden${NC}"; sleep 1; return
    fi

    if id "$username" &>/dev/null; then
        echo -e "${RED}  ✗ El usuario ya existe${NC}"; sleep 1; return
    fi

    if confirm_action; then
        useradd -m -s /bin/bash "$username"
        echo "$username:$pass" | chpasswd
        echo -e "${GREEN}  ✓ Usuario '$username' creado exitosamente${NC}"
    fi
    read -p "  Presione Enter para continuar..."
}

config_ssh_port() {
    show_banner
    echo -e "${GREEN}┌─────────────────────────────────────────────────────────────┐${NC}"
    echo -e "${GREEN}│${NC}               ${YELLOW}CONFIGURAR PUERTO SSH${NC}                   ${GREEN}│${NC}"
    echo -e "${GREEN}└─────────────────────────────────────────────────────────────┘${NC}"
    echo -e "${CYAN}  Puerto actual: ${WHITE}$SSH_PORT${NC}\n"
    read -p "  Nuevo puerto (1024-65535): " port
    if ! [[ $port =~ ^[0-9]+$ ]] || (( port < 1024 || port > 65535 )); then
        echo -e "${RED}  ✗ Puerto inválido${NC}"; sleep 1; return
    fi

    if confirm_action; then
        backup_configs
        sed -i "s/^Port .*/Port $port/" /etc/ssh/sshd_config 2>/dev/null || \
        sed -i "1i Port $port" /etc/ssh/sshd_config
        systemctl restart ssh
        SSH_PORT=$port
        echo -e "${GREEN}  ✓ Puerto SSH actualizado a $port${NC}"
    fi
    read -p "  Presione Enter para continuar..."
}

config_dropbear() {
    show_banner
    echo -e "${GREEN}┌─────────────────────────────────────────────────────────────┐${NC}"
    echo -e "${GREEN}│${NC}              ${YELLOW}CONFIGURAR DROPBEAR${NC}                       ${GREEN}│${NC}"
    echo -e "${GREEN}└─────────────────────────────────────────────────────────────┘${NC}"
    echo -e "${WHITE}  Dropbear es un servidor SSH ligero, ideal para conexiones WS.${NC}"
    echo -e "${CYAN}  Puerto actual: ${WHITE}$DROPBEAR_PORT${NC}\n"
    read -p "  Nuevo puerto (1024-65535): " port
    if ! [[ $port =~ ^[0-9]+$ ]] || (( port < 1024 || port > 65535 )); then
        echo -e "${RED}  ✗ Puerto inválido${NC}"; sleep 1; return
    fi

    if confirm_action; then
        backup_configs
        if ! systemctl is-active dropbear &>/dev/null; then
            systemctl enable dropbear
        fi
        cat > /etc/default/dropbear <<EOF
NO_START=0
DROPBEAR_EXTRA_ARGS="-p $port"
EOF
        systemctl restart dropbear
        DROPBEAR_PORT=$port
        echo -e "${GREEN}  ✓ Dropbear configurado en puerto $port${NC}"
    fi
    read -p "  Presione Enter para continuar..."
}

config_socks() {
    show_banner
    echo -e "${GREEN}┌─────────────────────────────────────────────────────────────┐${NC}"
    echo -e "${GREEN}│${NC}              ${YELLOW}CONFIGURAR PROXY SOCKS5${NC}                   ${GREEN}│${NC}"
    echo -e "${GREEN}└─────────────────────────────────────────────────────────────┘${NC}"
    echo ""
    echo -e "  1) SSH Dynamic Forwarding (ssh -D) → Rápido, sin demonio"
    echo -e "  2) Dante Server → Proxy SOCKS5 dedicado"
    echo -e "  3) SS5 → Alternativa ligera"
    echo ""
    read -p "  Método (1-3): " method
    read -p "  Puerto (1024-65535): " sp
    if ! [[ $sp =~ ^[0-9]+$ ]] || (( sp < 1024 || sp > 65535 )); then
        echo -e "${RED}  ✗ Puerto inválido${NC}"; sleep 1; return
    fi

    if confirm_action; then
        SOCKS_PORT=$sp
        case $method in
            1) echo -e "${GREEN}  ✓ Usa: ssh -D $sp -f -C -q -N user@TU_IP${NC}" ;;
            2) DEBIAN_FRONTEND=noninteractive apt install -y dante-server >/dev/null 2>&1
               cat > /etc/danted.conf <<EOF
logoutput: syslog
user.privileged: root
user.unprivileged: nobody
internal: eth0 port = $sp
external: eth0
method: username
clientmethod: none
user notprivileged: nobody
EOF
               systemctl restart danted
               echo -e "${GREEN}  ✓ Dante SOCKS5 activo en puerto $sp${NC}" ;;
            3) DEBIAN_FRONTEND=noninteractive apt install -y ss5 >/dev/null 2>&1
               sed -i "s/^SS5_ARGS=.*/SS5_ARGS=\"-u nobody -a 0.0.0.0:$sp\"/" /etc/sysconfig/ss5 2>/dev/null
               systemctl restart ss5
               echo -e "${GREEN}  ✓ SS5 SOCKS5 activo en puerto $sp${NC}" ;;
        esac
    fi
    read -p "  Presione Enter para continuar..."
}

config_ws() {
    show_banner
    echo -e "${GREEN}┌─────────────────────────────────────────────────────────────┐${NC}"
    echo -e "${GREEN}│${NC}            ${YELLOW}CONFIGURAR TUNNEL WEBSOCKET${NC}                 ${GREEN}│${NC}"
    echo -e "${GREEN}└─────────────────────────────────────────────────────────────┘${NC}"
    echo -e "${WHITE}  Envuelve SSH/Dropbear sobre WS para evitar restricciones de red.${NC}"
    echo -e "${CYAN}  Puerto WS actual: ${WHITE}$WS_PORT${NC}\n"
    read -p "  Puerto WS (80-65535): " wp
    if ! [[ $wp =~ ^[0-9]+$ ]] || (( wp < 80 || wp > 65535 )); then
        echo -e "${RED}  ✗ Puerto inválido${NC}"; sleep 1; return
    fi

    if confirm_action; then
        backup_configs
        WS_PORT=$wp
        local target_port=$DROPBEAR_PORT
        systemctl is-active dropbear &>/dev/null || target_port=$SSH_PORT

        mkdir -p /etc/stunnel
        cat > /etc/stunnel/stunnel.conf <<EOF
pid = /var/run/stunnel4.pid
[ws-tunnel]
accept = $wp
connect = 127.0.0.1:$target_port
TIMEOUTclose = 0
EOF
        systemctl restart stunnel4
        echo -e "${GREEN}  ✓ WebSocket tunnel activo: $wp -> $target_port${NC}"
    fi
    read -p "  Presione Enter para continuar..."
}

config_custom_port() {
    show_banner
    echo -e "${GREEN}┌─────────────────────────────────────────────────────────────┐${NC}"
    echo -e "${GREEN}│${NC}            ${YELLOW}CONFIGURAR PUERTO PERSONALIZADO${NC}               ${GREEN}│${NC}"
    echo -e "${GREEN}└─────────────────────────────────────────────────────────────┘${NC}"
    echo -e "${CYAN}  Rango recomendado: ${WHITE}40000 - 65535${NC}\n"
    read -p "  Puerto personalizado: " cp
    if ! [[ $cp =~ ^[0-9]+$ ]] || (( cp < 40000 || cp > 65535 )); then
        echo -e "${RED}  ✗ Fuera de rango${NC}"; sleep 1; return
    fi

    if confirm_action; then
        CUSTOM_PORT=$cp
        iptables -I INPUT -p tcp --dport $cp -j ACCEPT 2>/dev/null || ufw allow $cp/tcp 2>/dev/null
        echo -e "${GREEN}  ✓ Puerto $cp abierto en firewall${NC}"
    fi
    read -p "  Presione Enter para continuar..."
}

config_ssl() {
    show_banner
    echo -e "${GREEN}┌─────────────────────────────────────────────────────────────┐${NC}"
    echo -e "${GREEN}│${NC}                ${YELLOW}CONFIGURAR SSL/TLS${NC}                      ${GREEN}│${NC}"
    echo -e "${GREEN}└─────────────────────────────────────────────────────────────┘${NC}"
    echo ""
    if [ "$SSL_ENABLED" = false ]; then
        echo -e "${YELLOW}  Estado: ${RED}DESACTIVADO${NC}\n"
        read -p "  ¿Generar certificado auto-firmado? (s/n): " ans
        if [[ "$ans" =~ ^[sS]$ ]]; then
            read -p "  Dominio/IP: " domain
            backup_configs
            openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
                -keyout /etc/stunnel/server.key -out /etc/stunnel/server.crt \
                -subj "/CN=$domain" 2>/dev/null
            SSL_ENABLED=true
            echo -e "${GREEN}  ✓ SSL/TLS generado para $domain${NC}"
        fi
    else
        echo -e "${YELLOW}  Estado: ${GREEN}ACTIVADO${NC}\n"
        read -p "  ¿Eliminar certificado? (s/n): " ans
        if [[ "$ans" =~ ^[sS]$ ]]; then
            rm -f /etc/stunnel/server.{key,crt}
            SSL_ENABLED=false
            echo -e "${GREEN}  ✓ SSL/TLS eliminado${NC}"
        fi
    fi
    read -p "  Presione Enter para continuar..."
}

toggle_watchdog() {
    show_banner
    echo -e "${GREEN}┌─────────────────────────────────────────────────────────────┐${NC}"
    echo -e "${GREEN}│${NC}                  ${YELLOW}WATCHDOG SERVICE${NC}                       ${GREEN}│${NC}"
    echo -e "${GREEN}└─────────────────────────────────────────────────────────────┘${NC}"
    echo ""
    local wd_script="/usr/local/bin/atila-watchdog.sh"
    
    if [ ! -f "$wd_script" ]; then
        echo -e "${YELLOW}  Estado: ${RED}DESACTIVADO${NC}\n"
        read -p "  ¿Activar monitoreo de servicios? (s/n): " ans
        if [[ "$ans" =~ ^[sS]$ ]]; then
            cat > "$wd_script" <<'EOF'
#!/bin/bash
while true; do
    for svc in ssh dropbear stunnel4; do
        systemctl is-active $svc &>/dev/null || systemctl restart $svc
    done
    sleep 30
done
EOF
            chmod +x "$wd_script"
            cat > /etc/systemd/system/atila-watchdog.service <<EOF
[Unit]
Description=ATILA-VPS Watchdog
After=network.target

[Service]
ExecStart=$wd_script
Restart=always

[Install]
WantedBy=multi-user.target
EOF
            systemctl daemon-reload && systemctl enable --now atila-watchdog
            WATCHDOG_ENABLED=true
            echo -e "${GREEN}  ✓ Watchdog activado${NC}"
        fi
    else
        echo -e "${YELLOW}  Estado: ${GREEN}ACTIVADO${NC}\n"
        read -p "  ¿Desactivar? (s/n): " ans
        if [[ "$ans" =~ ^[sS]$ ]]; then
            systemctl disable --now atila-watchdog
            rm -f /etc/systemd/system/atila-watchdog.service "$wd_script"
            systemctl daemon-reload
            WATCHDOG_ENABLED=false
            echo -e "${GREEN}  ✓ Watchdog desactivado${NC}"
        fi
    fi
    read -p "  Presione Enter para continuar..."
}

block_user() {
    show_banner
    echo -e "${GREEN}┌─────────────────────────────────────────────────────────────┐${NC}"
    echo -e "${GREEN}│${NC}             ${YELLOW}BLOQUEAR/DESBLOQUEAR USUARIO${NC}                 ${GREEN}│${NC}"
    echo -e "${GREEN}└─────────────────────────────────────────────────────────────┘${NC}"
    echo ""
    read -p "  Usuario: " username
    if ! id "$username" &>/dev/null; then
        echo -e "${RED}  ✗ Usuario no existe${NC}"; sleep 1; return
    fi

    if passwd -S "$username" | grep -q "L"; then
        echo -e "${YELLOW}  Estado: BLOQUEADO${NC}"
        read -p "  ¿Desbloquear? (s/n): " ans
        if [[ "$ans" =~ ^[sS]$ ]]; then
            passwd -u "$username"
            echo -e "${GREEN}  ✓ Desbloqueado${NC}"
        fi
    else
        echo -e "${GREEN}  Estado: ACTIVO${NC}"
        read -p "  ¿Bloquear? (s/n): " ans
        if [[ "$ans" =~ ^[sS]$ ]]; then
            passwd -l "$username"
            echo -e "${GREEN}  ✓ Bloqueado${NC}"
        fi
    fi
    read -p "  Presione Enter para continuar..."
}

system_info() {
    show_banner
    echo -e "${GREEN}┌─────────────────────────────────────────────────────────────┐${NC}"
    echo -e "${GREEN}│${NC}              ${YELLOW}INFORMACIÓN DEL SISTEMA${NC}                   ${GREEN}│${NC}"
    echo -e "${GREEN}└─────────────────────────────────────────────────────────────┘${NC}"
    echo ""
    echo -e "${CYAN}  ╔════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}  ║${NC}  ${WHITE}General${NC}                                 ${CYAN}║${NC}"
    echo -e "${CYAN}  ╚════════════════════════════════════════╝${NC}"
    echo -e "  ${GREEN}➜${NC} OS: ${WHITE}$OS_NAME $VERSION_ID${NC}"
    echo -e "  ${GREEN}➜${NC} Kernel: ${WHITE}$(uname -r)${NC}"
    echo -e "  ${GREEN}➜${NC} IP Pública: ${WHITE}$(curl -s --max-time 3 ifconfig.me 2>/dev/null || echo 'N/A')${NC}"
    echo ""
    
    echo -e "${CYAN}  ╔════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}  ║${NC}  ${WHITE}Recursos${NC}                                ${CYAN}║${NC}"
    echo -e "${CYAN}  ╚════════════════════════════════════════╝${NC}"
    echo -e "  ${GREEN}➜${NC} CPU: ${WHITE}$(top -bn1 | grep "Cpu(s)" | awk '{print $2+$4}')%${NC}"
    echo -e "  ${GREEN}➜${NC} RAM: ${WHITE}$(free -m | awk 'NR==2{printf "%sMB (%.1f%%)", $3, $3*100/$2}')${NC}"
    echo -e "  ${GREEN}➜${NC} Disco: ${WHITE}$(df -h / | awk 'NR==2{printf "%s (%s)", $3, $5}')${NC}"
    echo ""
    
    echo -e "${CYAN}  ╔════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}  ║${NC}  ${WHITE}Configuración Activa${NC}                    ${CYAN}║${NC}"
    echo -e "${CYAN}  ╚════════════════════════════════════════╝${NC}"
    echo -e "  ${GREEN}➜${NC} SSH: $SSH_PORT | Dropbear: $DROPBEAR_PORT"
    echo -e "  ${GREEN}➜${NC} SOCKS5: $SOCKS_PORT | WS: $WS_PORT | Custom: $CUSTOM_PORT"
    echo -e "  ${GREEN}➜${NC} SSL: $([ "$SSL_ENABLED" = true ] && echo "ON" || echo "OFF") | Watchdog: $([ "$WATCHDOG_ENABLED" = true ] && echo "ON" || echo "OFF")${NC}"
    echo ""
    read -p "  Presione Enter para continuar..."
}

restart_services() {
    show_banner
    echo -e "${GREEN}┌─────────────────────────────────────────────────────────────┐${NC}"
    echo -e "${GREEN}│${NC}                ${YELLOW}REINICIAR SERVICIOS${NC}                     ${GREEN}│${NC}"
    echo -e "${GREEN}└─────────────────────────────────────────────────────────────┘${NC}"
    echo ""
    if confirm_action; then
        for svc in ssh dropbear stunnel4 danted ss5; do
            systemctl is-active $svc &>/dev/null && systemctl restart $svc 2>/dev/null
        done
        echo -e "${GREEN}  ✓ Servicios reiniciados${NC}"
    fi
    read -p "  Presione Enter para continuar..."
}

change_theme() {
    show_banner
    echo -e "${GREEN}┌─────────────────────────────────────────────────────────────┐${NC}"
    echo -e "${GREEN}│${NC}                   ${YELLOW}CAMBIAR TEMA${NC}                          ${GREEN}│${NC}"
    echo -e "${GREEN}└─────────────────────────────────────────────────────────────┘${NC}"
    echo -e "\n  1) Oscuro  2) Claro  3) Matrix  4) Azul\n"
    read -p "  Tema (1-4): " t
    case $t in
        1) GREEN='\033[1;32m'; CYAN='\033[1;36m' ;;
        2) GREEN='\033[0;32m'; CYAN='\033[0;36m' ;;
        3) GREEN='\033[1;32m'; CYAN='\033[1;32m' ;;
        4) GREEN='\033[1;34m'; CYAN='\033[1;36m' ;;
        *) echo -e "${RED}  ✗ Inválido${NC}"; sleep 1; return ;;
    esac
    echo -e "${GREEN}  ✓ Tema aplicado${NC}"
    read -p "  Presione Enter para continuar..."
}

# =============================================================================
# MAIN
# =============================================================================
main() {
    check_root
    detect_os
    install_deps
    backup_configs

    echo -e "${YELLOW}⚡ ATILA-VPS MANAGER v2.0-PRO Iniciado${NC}"
    echo -e "${CYAN}   Ejecutando en modo real. Los cambios afectarán tu sistema.${NC}\n"
    sleep 1.5

    while true; do
        show_menu
        read -r opt
        case $opt in
            1) create_user ;;
            2) config_ssh_port ;;
            3) config_dropbear ;;
            4) config_socks ;;
            5) config_ws ;;
            6) config_custom_port ;;
            7) config_ssl ;;
            8) toggle_watchdog ;;
            9) block_user ;;
            10) system_info ;;
            11) restart_services ;;
            12) change_theme ;;
            0) show_banner
               echo -e "${GREEN}  ¡Gracias por usar ATILA-VPS MANAGER!${NC}"
               echo -e "${YELLOW}  Backups en: $BACKUP_DIR${NC}\n"
               exit 0 ;;
            *) echo -e "${RED}  ✗ Opción inválida${NC}"; sleep 1 ;;
        esac
    done
}

main
