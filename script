    # Crear servicio systemd
    cat > /etc/systemd/system/badvpn.service << EOF
[Unit]
Description=BadVPN Tunnel
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/badvpn-tun2socks --tundev dev-tun --netif-ipaddr 10.0.0.1 --netif-netmask 255.255.255.0 --socks-listen-addr 127.0.0.1:${BADVPN_PORT}
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF
    
