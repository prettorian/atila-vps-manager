check_updates() {
    info "Verificando actualizaciones de ATILA-VPS..."
    
    if command -v git &>/dev/null && [[ -d /opt/atila-vps/.git ]]; then
        cd /opt/atila-vps
        git fetch --quiet origin
        local local_rev remote_rev
        local_rev=$(git rev-parse HEAD)
        remote_rev=$(git rev-parse origin/main)
        
        if [[ "${local_rev}" != "${remote_rev}" ]]; then
            echo -e "${C_YELLOW}✓ Nueva versión disponible!${C_RESET}"
            echo -e "${C_CYAN}Ejecuta: ${C_WHITE}sudo ${SCRIPT_NAME} --update${C_RESET}"
            return 0
        else
            success "Ya tienes la última versión ✓"
        fi
    else
        info "Actualización manual: descarga desde el repositorio oficial"
    fi
}

update_script() {
    info "Actualizando ATILA-VPS..."
    
    if [[ -d /opt/atila-vps/.git ]]; then
        cd /opt/atila-vps
        git pull origin main
        success "Script actualizado"
    else
        warn "Instalación no detectada como git. Descarga manual desde el repositorio oficial"
    fi
}

# ═══════════════════════════════════════════════════════════════════════════
# 🔐 SISTEMA HWID (LICENCIAS POR HARDWARE)
# ═══════════════════════════════════════════════════════════════════════════
generate_hwid() {
    # Generar ID único basado en hardware
    local hwid
    hwid=$(cat /etc/machine-id 2>/dev/null || dmidecode -s system-uuid 2>/dev/null || hostname)
    echo -n "${hwid}" | sha256sum | cut -d' ' -f1 | head -c 32
}

validate_license() {
    local license_key="$1"
    local hwid_file="${CONFIG_DIR}/.hwid"
    
    # Si no existe archivo HWID, crearlo
    if [[ ! -f "${hwid_file}" ]]; then
        generate_hwid > "${hwid_file}"
        chmod 600 "${hwid_file}"
    fi
    
    local stored_hwid
    stored_hwid=$(cat "${hwid_file}")
    
    # Validación básica (en producción, verificar con servidor de licencias)
    if [[ "${license_key}" == *"$(echo -n "${stored_hwid}" | base64 | head -c 16)"* ]]; then
        return 0
    fi
    
    return 1
}

# ═══════════════════════════════════════════════════════════════════════════
# 🌍 BLOQUEO DE PAÍSES POR IP
# ═══════════════════════════════════════════════════════════════════════════
block_country() {
    local country_code="$1"  # Ej: CN, RU, US
    
    if [[ -z "${country_code}" ]]; then
        error "Código de país requerido (ej: CN, RU, BR)"
        return 1
    fi
    
    info "Descargando IPs de ${country_code}..."
    
    # Usar ipdeny.com para obtener ranges de IP por país
    local ip_list_url="https://www.ipdeny.com/ipblocks/data/countries/${country_code,,}.zone"
    
    if curl -s "${ip_list_url}" -o "${TMP_DIR}/${country_code}.zone"; then
        local count=0
        while read -r ip_range; do
            iptables -A INPUT -s "${ip_range}" -j DROP 2>/dev/null || true
            ((count++)) || true
        done < "${TMP_DIR}/${country_code}.zone"
        
        success "Bloqueadas ${count} redes de ${country_code}"
        rm -f "${TMP_DIR}/${country_code}.zone"
    else
        error "No se pudo descargar lista de IPs para ${country_code}"
    fi
}

unblock_country() {
    local country_code="$1"
    
    # Remover reglas específicas (requiere guardar reglas con comentarios)
    warn "Para desbloquear ${country_code}, elimina manualmente las reglas iptables o restaura desde backup"
}

