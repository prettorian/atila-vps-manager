# 📊 CONTROL DE ANCHO DE BANDA
# ═══════════════════════════════════════════════════════════════════════════
apply_bandwidth_limit() {
    local username="$1"
    local limit_kbps="$2"
    
    local uid
    uid=$(id -u "${username}" 2>/dev/null) || return 1
    
    local iface
    iface=$(ip route | grep default | awk '{print $5}' | head -1)
    
    # Cargar módulo tc si es necesario
    lsmod | grep -q sch_htb || modprobe sch_htb 2>/dev/null || true
    
    # Configurar qdisc root
    tc qdisc add dev "${iface}" root handle 1: htb default 30 2>/dev/null || true
    
    # Clase para el usuario
    tc class add dev "${iface}" parent 1: classid 1:${uid} htb rate "${limit_kbps}kbit" ceil "${limit_kbps}kbit" 2>/dev/null || true
    
    # Filtrar por UID con iptables mark
    iptables -t mangle -A POSTROUTING -m owner --uid-owner "${uid}" -j MARK --set-mark "${uid}" 2>/dev/null || true
    tc filter add dev "${iface}" parent 1: protocol ip handle "${uid}:" fw flowid 1:${uid} 2>/dev/null || true
    
    # Guardar configuración
    echo "${username}:${uid}:${limit_kbps}" >> "${BANDWIDTH_FILE}"
    
    info "Límite de ${limit_kbps} KB/s aplicado para ${username}"
}

clear_bandwidth_limit() {
    local username="$1"
    local uid
    uid=$(id -u "${username}" 2>/dev/null) || return 0
    
    # Remover regla iptables
    iptables -t mangle -D POSTROUTING -m owner --uid-owner "${uid}" -j MARK --set-mark "${uid}" 2>/dev/null || true
    
    # Remover de archivo
    sed -i "/^${username}:/d" "${BANDWIDTH_FILE}" 2>/dev/null || true
    
    info "Límite de bandwidth removido para ${username}"
}

