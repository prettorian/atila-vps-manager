                ;;
            18) create_backup ;;
            19)
                msg -ne "Ruta del backup a restaurar: "; read -r backup_path
                restore_backup "${backup_path}"
                ;;
            20) check_updates ;;
            99)
                warn "Reiniciando servicios..."
                systemctl restart ssh 2>/dev/null || service ssh restart 2>/dev/null || true
                systemctl restart dropbear 2>/dev/null || true
                systemctl restart atila-ws 2>/dev/null || true
