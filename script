# 📋 MODO NO INTERACTIVO (CLI)
# ═══════════════════════════════════════════════════════════════════════════
usage() {
    cat << EOF
╔════════════════════════════════════════════════════════════════╗
║              🛡️  ATILA-VPS v${SCRIPT_VERSION} - Línea de Comandos  🛡️ ║
╚════════════════════════════════════════════════════════════════╝

Uso: ${SCRIPT_NAME}.sh [COMANDO] [OPCIONES]

GESTIÓN DE USUARIOS:
  --create USER [PASS] [PORT] [BW]   Crear usuario proxy
  --delete USER                      Eliminar usuario
  --list                             Listar usuarios
  --creds USER                       Mostrar credenciales
  --connections                      Ver conexiones activas
  --kill USER                        Terminar conexiones de usuario

PROTOCOLOS:
  --install-dropbear                 Instalar Dropbear SSH
  --dropbear-ports "443 777"         Configurar puertos Dropbear
  --install-websocket                Instalar WebSocket SOCKS (GOST)
  --ws-port PORT                     Cambiar puerto WebSocket
  --install-shadowsocks              Instalar Shadowsocks
  --install-v2ray                    Instalar V2Ray
  --install-trojan                   Instalar Trojan
  --install-wireguard                Instalar WireGuard
  --install-openvpn                  Instalar OpenVPN
  --install-badvpn                   Instalar BadVPN (UDP)

GESTIÓN:
  --install                          Instalación inicial completa
  --backup                           Crear backup de configuración
  --restore FILE                     Restaurar desde backup
  --update                           Actualizar script
  --check-updates                    Verificar actualizaciones
  --sync-ws-auth                     Sincronizar auth WebSocket

REDES:
  --block-country CODE               Bloquear país (ej: CN, RU)
  --unblock-country CODE             Desbloquear país
  --set-bandwidth USER KBPS          Configurar límite de ancho de banda
  --kill-duplicates                  Auto-kill conexiones duplicadas

OTROS:
  --menu                             Ejecutar menú interactivo (por defecto)
  --hwid                             Mostrar HWID del sistema
  --help                             Mostrar esta ayuda

EJEMPLOS:
  ${SCRIPT_NAME}.sh --install
  ${SCRIPT_NAME}.sh --create juan123 MiPass123 1081 512
  ${SCRIPT_NAME}.sh --dropbear-ports "443 777 2222"
  ${SCRIPT_NAME}.sh --ws-port 443
  ${SCRIPT_NAME}.sh --install-websocket
  ${SCRIPT_NAME}.sh --list

NOTAS:
  • Requiere ejecución como root: sudo ./${SCRIPT_NAME}.sh
  • Usuarios creados tienen acceso restringido (solo proxy)
  • Compatible: Ubuntu 18.04-24.04, Debian 9-12
  • Documentación completa: https://github.com/prettorian/atila-vps-manager

EOF
}

# ═══════════════════════════════════════════════════════════════════════════
# 🚀 PUNTO DE ENTRADA PRINCIPAL
# ═══════════════════════════════════════════════════════════════════════════
main() {
    check_root
    check_distro
    check_internet
    
    # Si no hay argumentos, mostrar menú interactivo
    if [[ $# -eq 0 ]]; then
        init_directories
        run_interactive_menu
        return
    fi
    
    # Procesar argumentos
    case "${1}" in
        --install)
            info "🚀 Iniciando instalación de ATILA-VPS v${SCRIPT_VERSION}..."
            init_directories
            init_dependencies
            init_ssh_server
            init_network
            init_firewall
            success "✅ ATILA-VPS instalado correctamente"
            echo -e "\n${C_CYAN}Ejecuta ${C_WHITE}sudo ./${SCRIPT_NAME}.sh --menu${C_CYAN} para comenzar${C_RESET}\n"
            ;;
        --create)
            [[ $# -lt 2 ]] && { error "Se requiere nombre de usuario"; usage; exit 1; }
            create_user "${2}" "${3:-}" "${4:-1080}" "${5:-0}"
            ;;
        --delete)
            [[ $# -lt 2 ]] && { error "Se requiere nombre de usuario"; exit 1; }
            delete_user "${2}"
            ;;
        --list) list_users ;;
        --creds)
            [[ $# -lt 2 ]] && { error "Se requiere nombre de usuario"; exit 1; }
            show_user_credentials "${2}"
            ;;
        --connections) show_active_connections ;;
        --kill)
            [[ $# -lt 2 ]] && { error "Se requiere nombre de usuario"; exit 1; }
            kill_user_connections "${2}"
            ;;
        --install-dropbear) install_dropbear ;;
        --dropbear-ports)
            [[ $# -lt 2 ]] && { error "Se requiere lista de puertos"; exit 1; }
            echo "${2}" > "${CONFIG_DIR}/dropbear_ports.conf"
            install_dropbear
            ;;
        --install-websocket) install_websocket ;;
        --ws-port)
            [[ $# -lt 2 ]] && { error "Se requiere puerto"; exit 1; }
            echo "${2}" > "${CONFIG_DIR}/ws_port.conf"
            configure_websocket_port
            ;;
        --install-shadowsocks) install_shadowsocks ;;
        --install-v2ray) install_v2ray ;;
        --install-trojan) install_trojan ;;
        --install-wireguard) install_wireguard ;;
        --install-openvpn) install_openvpn ;;
        --install-badvpn) install_badvpn ;;
        --backup) create_backup ;;
        --restore)
            [[ $# -lt 2 ]] && { error "Se requiere ruta de backup"; exit 1; }
            restore_backup "${2}"
            ;;
        --update) update_script ;;
        --check-updates) check_updates ;;
        --block-country)
            [[ $# -lt 2 ]] && { error "Se requiere código de país"; exit 1; }
            block_country "${2}"
            ;;
        --unblock-country)
            [[ $# -lt 2 ]] && { error "Se requiere código de país"; exit 1; }
            unblock_country "${2}"
            ;;
        --set-bandwidth)
            [[ $# -lt 3 ]] && { error "Se requiere usuario y límite KB/s"; exit 1; }
            apply_bandwidth_limit "${2}" "${3}"
            ;;
        --kill-duplicates) auto_kill_duplicates ;;
        --sync-ws-auth) sync_ws_auth; success "Auth WebSocket sincronizado" ;;
        --hwid)
            echo -e "${C_CYAN}HWID de este sistema:${C_RESET} $(generate_hwid)"
            ;;
        --menu)
            init_directories
            run_interactive_menu
            ;;
        --help|-h) usage ;;
        *)
            error "Comando desconocido: ${1}"
            usage
            exit 1
            ;;
    esac
}

