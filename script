readonly SCRIPT_NAME="atila-vps"
readonly SCRIPT_VERSION="3.0.0"
readonly BASE_DIR="/etc/atila-vps"
readonly CONF_DIR="${BASE_DIR}/controlador"
readonly TOOLS_DIR="${BASE_DIR}/herramientas"
readonly PROTO_DIR="${BASE_DIR}/protocolos"
readonly CONFIG_DIR="${BASE_DIR}/config"
readonly CERTS_DIR="${BASE_DIR}/certs"
readonly LOG_FILE="/var/log/atila-vps.log"
readonly USERS_FILE="${CONF_DIR}/usuarios.conf"
readonly WS_AUTH_FILE="${CONF_DIR}/ws_auth.txt"
readonly BANDWIDTH_FILE="${CONF_DIR}/bandwidth.conf"
readonly BACKUP_DIR="${BASE_DIR}/backups"
readonly TMP_DIR="${BASE_DIR}/tmp"

# Puertos por defecto
readonly SSH_PORT=22
readonly DROPBEAR_DEFAULT_PORTS="443 777 2222"
readonly WS_DEFAULT_PORT=443
readonly SHADOWSOCKS_PORT=8388
readonly V2RAY_PORT=443
readonly TROJAN_PORT=443
readonly WIREGUARD_PORT=51820
readonly OPENVPN_PORT=1194
readonly BADVPN_PORT=7300

# Límites
readonly DEFAULT_BW_KBPS=1024
readonly MAX_LOGIN_PER_USER=1
readonly SESSION_TIMEOUT=300

# Colores ANSI
readonly C_RESET='\033[0m'
readonly C_RED='\033[0;31m'
readonly C_GREEN='\033[0;32m'
readonly C_YELLOW='\033[1;33m'
readonly C_BLUE='\033[0;34m'
readonly C_CYAN='\033[0;36m'
readonly C_MAGENTA='\033[0;35m'
readonly C_BOLD='\033[1m'
readonly C_UNDERLINE='\033[4m'

# ═══════════════════════════════════════════════════════════════════════════
# 📝 UTILIDADES & LOGGING
# ═══════════════════════════════════════════════════════════════════════════
log() {
    local level="$1"; shift
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [${level}] $*" >> "${LOG_FILE}"
}

msg() {
    case "${1}" in
        -bar) echo -e "${C_BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}" ;;
        -ama) echo -e "${C_YELLOW}${C_BOLD}${2}${C_RESET}" ;;
        -verd) echo -e "${C_GREEN}${C_BOLD}${2}${C_RESET}" ;;
        -rojo) echo -e "${C_RED}${C_BOLD}${2}${C_RESET}" ;;
        -ne) echo -ne "${C_YELLOW}${2}${C_RESET}" ;;
        -title) echo -e "\n${C_CYAN}${C_BOLD}╔════════════════════════════════════════╗${C_RESET}"; \
                echo -e "${C_CYAN}${C_BOLD}║  ${2}${C_RESET}"; \
                echo -e "${C_CYAN}${C_BOLD}╚════════════════════════════════════════╝${C_RESET}\n" ;;
    esac
}

success() { echo -e "${C_GREEN}✓ ${*}${C_RESET}"; log "INFO" "$*"; }
info()    { echo -e "${C_CYAN}ℹ ${*}${C_RESET}"; log "INFO" "$*"; }
warn()    { echo -e "${C_YELLOW}⚠ ${*}${C_RESET}"; log "WARN" "$*"; }
error()   { echo -e "${C_RED}✗ ${*}${C_RESET}"; log "ERROR" "$*"; }

print_option() {
    echo -e "${C_GREEN}┌─${C_RESET} ${C_YELLOW}[$(printf '%02d' "${1}")]${C_RESET} ${C_CYAN}${2}${C_RESET}"
}

# ═══════════════════════════════════════════════════════════════════════════
# 🔍 VERIFICACIONES DEL SISTEMA
# ═══════════════════════════════════════════════════════════════════════════
check_root() {
    if [[ $EUID -ne 0 ]]; then
        error "Este script debe ejecutarse como root"
        echo -e "${C_YELLOW}Ejecuta: sudo ./${SCRIPT_NAME}.sh${C_RESET}"
        exit 1
    fi
}

check_distro() {
    if [[ ! -f /etc/os-release ]]; then
        error "No se pudo detectar la distribución de Linux"
        exit 1
    fi
    
    source /etc/os-release
    case "${ID}" in
        ubuntu)
            if [[ "${VERSION_ID}" =~ ^(18\.04|20\.04|22\.04|24\.04)$ ]]; then
                success "Ubuntu ${VERSION_ID} detectado - Compatible ✓"
                return 0
            else
                error "Ubuntu ${VERSION_ID} no compatible. Usa 18.04, 20.04, 22.04 o 24.04"
                exit 1
            fi
            ;;
        debian)
            if [[ "${VERSION_ID}" =~ ^(9|10|11|12)$ ]]; then
                success "Debian ${VERSION_ID} detectado - Compatible ✓"
                return 0
            else
                error "Debian ${VERSION_ID} no compatible. Usa 9, 10, 11 o 12"
                exit 1
            fi
            ;;
        *)
            error "Distribución '${PRETTY_NAME}' no compatible con ATILA-VPS"
            echo -e "${C_YELLOW}Soportadas: Ubuntu 18.04-24.04, Debian 9-12${C_RESET}"
            exit 1
            ;;
    esac
}

check_internet() {
    if ! ping -c 1 -W 5 8.8.8.8 &>/dev/null; then
        error "No hay conexión a internet. Verifica tu red."
        exit 1
    fi
    success "Conexión a internet verificada ✓"
}

get_package_manager() {
    if command -v apt &>/dev/null; then
        echo "apt"
    elif command -v yum &>/dev/null; then
        echo "yum"
    elif command -v dnf &>/dev/null; then
        echo "dnf"
    else
        error "Gestor de paquetes no soportado"
        exit 1
    fi
}

install_package() {
    local pkg="$1"
    local pm=$(get_package_manager)
    case "${pm}" in
        apt) apt install -y -qq "${pkg}" 2>/dev/null ;;
        yum) yum install -y -q "${pkg}" 2>/dev/null ;;
        dnf) dnf install -y -q "${pkg}" 2>/dev/null ;;
    esac
}

# ═══════════════════════════════════════════════════════════════════════════
# ⚙️ CONFIGURACIÓN INICIAL
# ═══════════════════════════════════════════════════════════════════════════
init_directories() {
    info "Creando estructura de directorios..."
    mkdir -p "${CONF_DIR}" "${TOOLS_DIR}" "${PROTO_DIR}" "${CONFIG_DIR}" "${CERTS_DIR}" "${BACKUP_DIR}" "${TMP_DIR}"
    touch "${USERS_FILE}" "${WS_AUTH_FILE}" "${BANDWIDTH_FILE}"
    chmod 700 "${BASE_DIR}" "${CONF_DIR}" "${BACKUP_DIR}"
    chmod 600 "${USERS_FILE}" "${WS_AUTH_FILE}"
    success "Estructura de directorios creada ✓"
}

init_dependencies() {
    info "Instalando dependencias del sistema..."
    
    local -a pkgs=(
        curl wget jq tar gzip unzip net-tools iptables iptables-persistent
        openssh-server sudo cron bc lsof grep sed awk openssl
        python3 python3-pip python3-venv git ca-certificates
    )
    
    local pm=$(get_package_manager)
    if [[ "${pm}" == "apt" ]]; then
        apt update -qq 2>/dev/null
        apt upgrade -y -qq 2>/dev/null
    fi
    
    for pkg in "${pkgs[@]}"; do
        if ! command -v "${pkg%%-*}" &>/dev/null && ! dpkg -l | grep -q "^ii  ${pkg}"; then
            install_package "${pkg}" 2>/dev/null || warn "No se pudo instalar: ${pkg}"
        fi
    done
    
    success "Dependencias instaladas ✓"
}

init_ssh_server() {
    info "Configurando servidor SSH para ATILA-VPS..."
    local sshd="/etc/ssh/sshd_config"
    
    # Backup
    cp "${sshd}" "${sshd}.atila-backup.$(date +%s)" 2>/dev/null || true
    
    # Parámetros esenciales
    local -a ssh_opts=(
        "Port ${SSH_PORT}"
        "PermitRootLogin prohibit-password"
        "PasswordAuthentication yes"
        "PubkeyAuthentication yes"
        "AllowTcpForwarding yes"
        "GatewayPorts no"
        "PermitTunnel yes"
        "X11Forwarding no"
        "AllowAgentForwarding yes"
        "ClientAliveInterval ${SESSION_TIMEOUT}"
        "ClientAliveCountMax 2"
        "MaxAuthTries 3"
        "MaxSessions 10"
        "UseDNS no"
        "PermitEmptyPasswords no"
        "ChallengeResponseAuthentication no"
    )
    
    for opt in "${ssh_opts[@]}"; do
        local key="${opt%% *}"
        if grep -q "^${key}" "${sshd}" 2>/dev/null; then
            sed -i "s|^${key}.*|${opt}|" "${sshd}"
        else
            echo "${opt}" >> "${sshd}"
        fi
    done
    
    # Grupo para usuarios proxy
    groupadd -f ssh-proxy-users 2>/dev/null || true
    
    # Reiniciar SSH
    if systemctl is-active --quiet ssh 2>/dev/null; then
        systemctl reload ssh
    elif service ssh status &>/dev/null; then
        service ssh reload
    fi
    
    success "SSH configurado para ATILA-VPS ✓"
}

init_network() {
    info "Configurando red para compartir internet (NAT)..."
    
    # Habilitar IP forwarding
    if [[ $(sysctl -n net.ipv4.ip_forward 2>/dev/null) != "1" ]]; then
        sysctl -w net.ipv4.ip_forward=1
        echo "net.ipv4.ip_forward=1" >> /etc/sysctl.conf
    fi
    
    # Obtener interfaz principal
    local iface
    iface=$(ip route | grep default | awk '{print $5}' | head -1)
    [[ -z "${iface}" ]] && iface="eth0"
    
    # Reglas iptables para NAT
    iptables -t nat -F POSTROUTING 2>/dev/null || true
    iptables -t nat -A POSTROUTING -o "${iface}" -j MASQUERADE
    
    # Reglas de forwarding
    iptables -A FORWARD -i "${iface}" -o "${iface}" -m state --state RELATED,ESTABLISHED -j ACCEPT
    iptables -A FORWARD -i "${iface}" -o "${iface}" -j ACCEPT
    
    # Persistencia de reglas
    mkdir -p /etc/iptables
    iptables-save > /etc/iptables/rules.v4 2>/dev/null || true
    
    success "Red NAT configurada en interfaz: ${iface} ✓"
}

init_firewall() {
    info "Configurando firewall básico..."
    
    # Permitir SSH
    iptables -A INPUT -p tcp --dport ${SSH_PORT} -j ACCEPT 2>/dev/null || true
    
    # Permitir puertos de servicios ATILA-VPS
    for port in ${DROPBEAR_DEFAULT_PORTS} ${WS_DEFAULT_PORT} ${SHADOWSOCKS_PORT} ${V2RAY_PORT} ${TROJAN_PORT} ${WIREGUARD_PORT} ${OPENVPN_PORT} ${BADVPN_PORT}; do
        iptables -A INPUT -p tcp --dport ${port} -j ACCEPT 2>/dev/null || true
        iptables -A INPUT -p udp --dport ${port} -j ACCEPT 2>/dev/null || true
    done
    
    # Permitir ICMP (ping)
    iptables -A INPUT -p icmp --icmp-type echo-request -j ACCEPT 2>/dev/null || true
    
    # Política por defecto
    iptables -P INPUT DROP 2>/dev/null || true
    iptables -P FORWARD ACCEPT 2>/dev/null || true
    iptables -P OUTPUT ACCEPT 2>/dev/null || true
    
    success "Firewall configurado ✓"
}

# ═══════════════════════════════════════════════════════════════════════════
# 👥 GESTIÓN DE USUARIOS SSH
# ═══════════════════════════════════════════════════════════════════════════
generate_password() {
    local length="${1:-12}"
    openssl rand -base64 "${length}" | tr -d '/+=' | head -c "${length}"
}

validate_username() {
    local username="$1"
    [[ "${username}" =~ ^[a-z][a-z0-9_-]{2,31}$ ]]
}

validate_port() {
    local port="$1"
    [[ "${port}" =~ ^[0-9]+$ ]] && [[ "${port}" -ge 1024 ]] && [[ "${port}" -le 65535 ]]
}

create_user() {
    local username="$1"
    local password="${2:-}"
    local port="${3:-1080}"
    local bandwidth="${4:-${DEFAULT_BW_KBPS}}"
    
    # Validaciones
    if ! validate_username "${username}"; then
        error "Nombre de usuario inválido. Usa: letras minúsculas, números, guiones"
        return 1
    fi
    
    if id "${username}" &>/dev/null; then
        error "El usuario '${username}' ya existe"
        return 1
    fi
    
    # Generar contraseña si no se proporciona
    if [[ -z "${password}" ]]; then
        password=$(generate_password)
    fi
    
    # Validar puerto
    if ! validate_port "${port}"; then
        error "Puerto inválido. Debe estar entre 1024 y 65535"
        return 1
    fi
    
    # Crear usuario restringido (solo para proxy)
    useradd -m -s /usr/sbin/nologin -G ssh-proxy-users "${username}"
    echo "${username}:${password}" | chpasswd
    
    # Configurar límites de bandwidth
    if [[ "${bandwidth}" -gt 0 ]]; then
        apply_bandwidth_limit "${username}" "${bandwidth}"
    fi
    
    # Registrar usuario
    local ip_server
    ip_server=$(hostname -I | awk '{print $1}')
    echo "${username}:${password}:${port}:${bandwidth}:$(date '+%Y-%m-%d %H:%M:%S'):0" >> "${USERS_FILE}"
    
    # Sincronizar con WebSocket auth
    sync_ws_auth
    
    # Mostrar credenciales
    echo -e "\n${C_GREEN}╔════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_GREEN}║${C_RESET}  ${C_BOLD}Usuario ATILA-VPS Creado${C_RESET}  ${C_GREEN}║${C_RESET}"
    echo -e "${C_GREEN}╚════════════════════════════════════════╝${C_RESET}\n"
    echo -e "${C_CYAN}Servidor:${C_RESET} ${ip_server}"
    echo -e "${C_CYAN}Puerto SSH:${C_RESET} ${SSH_PORT}"
    echo -e "${C_CYAN}Puerto SOCKS:${C_RESET} ${port}"
    echo -e "${C_CYAN}Usuario:${C_RESET} ${username}"
    echo -e "${C_CYAN}Contraseña:${C_RESET} ${C_YELLOW}${password}${C_RESET}"
    echo -e "${C_CYAN}Ancho de banda:${C_RESET} ${bandwidth} KB/s"
    echo -e "\n${C_CYAN}Comando de conexión SSH:${C_RESET}"
    echo -e "${C_WHITE}ssh -D ${port} -q -C -N ${username}@${ip_server}${C_RESET}"
    echo -e "\n${C_CYAN}Comando de conexión WebSocket:${C_RESET}"
    echo -e "${C_WHITE}wss://${username}:${password}@${ip_server}:${WS_DEFAULT_PORT}${C_RESET}"
    echo -e "\n${C_YELLOW}Configura tu navegador/app para usar SOCKS5 en localhost:${port}${C_RESET}\n"
    
    success "Usuario '${username}' creado exitosamente"
    return 0
}

delete_user() {
    local username="$1"
    
    if [[ -z "${username}" ]]; then
        error "Nombre de usuario requerido"
        return 1
    fi
    
    if ! id "${username}" &>/dev/null; then
        error "El usuario '${username}' no existe"
        return 1
    fi
    
    # Eliminar reglas de bandwidth
    clear_bandwidth_limit "${username}"
    
    # Eliminar sesiones activas
    pkill -u "${username}" 2>/dev/null || true
    
    # Eliminar usuario
    userdel -r "${username}" 2>/dev/null || userdel "${username}"
    
    # Remover de archivo de usuarios
    sed -i "/^${username}:/d" "${USERS_FILE}" 2>/dev/null || true
    
    # Sincronizar WebSocket auth
    sync_ws_auth
    
    success "Usuario '${username}' eliminado"
    return 0
}

list_users() {
    msg -title "📋 Usuarios Registrados"
    
    if [[ ! -s "${USERS_FILE}" ]]; then
        echo -e "${C_YELLOW}No hay usuarios registrados.${C_RESET}"
        return
    fi
    
    printf "${C_BOLD}%-20s %-10s %-10s %-12s %-10s %s${C_RESET}\n" "USUARIO" "PUERTO" "BW(KB)" "CREADO" "ACTIVAS" "ESTADO"
    msg -bar
    
    while IFS=: read -r username password port bandwidth created connections; do
        local status="🟢 Activo"
        local active_conn=0
        
        # Verificar si usuario existe y conexiones activas
        if id "${username}" &>/dev/null; then
            active_conn=$(ss -tnp 2>/dev/null | grep -c "${username}" || echo "0")
        else
            status="🔴 Inactivo"
        fi
        
        printf "%-20s %-10s %-10s %-12s %-10s %s\n" \
            "${username}" "${port}" "${bandwidth}" "${created:0:10}" "${active_conn}" "${status}"
    done < "${USERS_FILE}"
    echo ""
}

