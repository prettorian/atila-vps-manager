    local username="$1"
    
    if [[ -z "${username}" ]]; then
        error "Nombre de usuario requerido"
        return 1
    fi
    
    local user_data
    user_data=$(grep "^${username}:" "${USERS_FILE}" 2>/dev/null || echo "")
    
    if [[ -z "${user_data}" ]]; then
        error "Usuario '${username}' no encontrado"
        return 1
    fi
    
    IFS=: read -r user pass port bw created conns <<< "${user_data}"
    local ip_server
    ip_server=$(hostname -I | awk '{print $1}')
    
    echo -e "\n${C_GREEN}╔════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_GREEN}║${C_RESET}  ${C_BOLD}Credenciales: ${username}${C_RESET}  ${C_GREEN}║${C_RESET}"
    echo -e "${C_GREEN}╚════════════════════════════════════════╝${C_RESET}\n"
    echo -e "  ${C_CYAN}IP del Servidor:${C_RESET} ${ip_server}"
    echo -e "  ${C_CYAN}Puerto SSH:${C_RESET} ${SSH_PORT}"
    echo -e "  ${C_CYAN}Puerto SOCKS:${C_RESET} ${port}"
    echo -e "  ${C_CYAN}Usuario:${C_RESET} ${user}"
    echo -e "  ${C_CYAN}Contraseña:${C_RESET} ${C_YELLOW}${pass}${C_RESET}"
    echo -e "  ${C_CYAN}Ancho de banda:${C_RESET} ${bw} KB/s"
    echo -e "  ${C_CYAN}Creado:${C_RESET} ${created}"
    echo -e "\n${C_CYAN}Comando SSH:${C_RESET}"
    echo -e "  ${C_WHITE}ssh -D ${port} -q -C -N ${user}@${ip_server}${C_RESET}"
    echo -e "\n${C_CYAN}Comando WebSocket:${C_RESET}"
    echo -e "  ${C_WHITE}wss://${user}:${pass}@${ip_server}:${WS_DEFAULT_PORT}${C_RESET}"
