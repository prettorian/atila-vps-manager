    success "BadVPN instalado en puerto ${BADVPN_PORT}"
}

# ═══════════════════════════════════════════════════════════════════════════
# 🔍 MONITOREO Y CONEXIONES ACTIVAS
# ═══════════════════════════════════════════════════════════════════════════
show_active_connections() {
    msg -title "🔌 Conexiones SSH Activas"
    
    local connections
    connections=$(ss -tnp state established 2>/dev/null | grep sshd || echo "")
    
    if [[ -z "${connections}" ]]; then
        echo -e "${C_YELLOW}No hay conexiones activas.${C_RESET}\n"
        return
    fi
    
    printf "${C_BOLD}%-20s %-25s %-15s %s${C_RESET}\n" "USUARIO" "IP REMOTA" "PUERTO" "TIEMPO"
    msg -bar
    
    echo "${connections}" | while read -r line; do
        local user port remote_ip
        user=$(echo "${line}" | grep -oP 'users:\(\("\K[^"]+' || echo "desconocido")
        remote_ip=$(echo "${line}" | awk '{print $5}' | cut -d: -f1)
        port=$(echo "${line}" | awk '{print $5}' | cut -d: -f2)
        
        printf "%-20s %-25s %-15s %s\n" "${user}" "${remote_ip}" "${port}" "$(date '+%H:%M:%S')"
    done
    echo ""
}

kill_user_connections() {
    local username="$1"
    
    if [[ -z "${username}" ]]; then
        error "Nombre de usuario requerido"
        return 1
    fi
    
    local killed
    killed=$(pkill -9 -u "${username}" 2>/dev/null && echo "1" || echo "0")
    
    if [[ "${killed}" == "1" ]]; then
        success "Conexiones de '${username}' terminadas"
    else
        info "No hay conexiones activas para '${username}'"
    fi
}

auto_kill_duplicates() {
    info "Verificando conexiones duplicadas..."
    
    # Obtener usuarios con múltiples conexiones
    local users_with_multi
    users_with_multi=$(who | awk '{print $1}' | sort | uniq -c | awk '$1 > '"${MAX_LOGIN_PER_USER}"' {print $2}')
    
    for user in ${users_with_multi}; do
        warn "Usuario '${user}' tiene múltiples conexiones. Terminando extras..."
        # Mantener solo la primera conexión
        local sessions
        sessions=$(who | grep "^${user} " | awk '{print $2}' | tail -n +2)
        for session in ${sessions}; do
            pkill -9 -t "${session#pts/}" 2>/dev/null || true
        done
        success "Conexiones duplicadas de '${user}' eliminadas"
    done
}

# ═══════════════════════════════════════════════════════════════════════════
# 💾 BACKUP Y RESTORE
# ═══════════════════════════════════════════════════════════════════════════
create_backup() {
    local backup_name="atila-backup-$(date '+%Y%m%d-%H%M%S').tar.gz"
    local backup_path="${BACKUP_DIR}/${backup_name}"
    
    info "Creando backup: ${backup_name}"
    
    tar -czf "${backup_path}" \
        "${USERS_FILE}" \
        "${WS_AUTH_FILE}" \
        "${BANDWIDTH_FILE}" \
        /etc/ssh/sshd_config \
        /etc/default/dropbear \
        /etc/iptables/rules.v4 \
        "${BASE_DIR}" \
        2>/dev/null || warn "Algunos archivos no pudieron ser respaldados"
    
    if [[ -f "${backup_path}" ]]; then
        success "Backup creado: ${backup_path}"
        echo -e "${C_CYAN}Tamaño: $(du -h "${backup_path}" | cut -f1)${C_RESET}"
    else
        error "Falló la creación del backup"
    fi
}

restore_backup() {
    local backup_file="$1"
    
    if [[ ! -f "${backup_file}" ]]; then
        error "Archivo de backup no encontrado: ${backup_file}"
        return 1
    fi
    
    warn "Restaurando desde: ${backup_file}"
    echo -e "${C_YELLOW}Esto sobrescribirá configuraciones actuales. ¿Continuar? (s/N): ${C_RESET}"
    read -r confirm
    [[ "${confirm,,}" != "s" ]] && { info "Cancelado"; return 1; }
    
    tar -xzf "${backup_file}" -C / 2>/dev/null || {
        error "Falló la restauración"
        return 1
    }
    
    # Recargar servicios
    systemctl reload ssh 2>/dev/null || service ssh reload 2>/dev/null || true
    systemctl reload dropbear 2>/dev/null || true
    systemctl reload atila-ws 2>/dev/null || true
    
    success "Backup restaurado. Reinicia servicios si es necesario."
}

